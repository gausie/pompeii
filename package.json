{
  "name": "pompeii",
  "version": "0.0.0",
  "author": "Sam Gaus <sam@gaus.co.uk>",
  "homepage": "",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "format": "eslint src --fix --ext .ts && NODE_OPTIONS=\"--experimental-strip-types\" prettier --write .",
    "lint": "eslint src --ext .ts &&  NODE_OPTIONS=\"--experimental-strip-types\" prettier --check .",
    "watch": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch",
    "install-mafia": "npm run build && create-kolmafia-script --install",
    "test": "vitest run --dir test",
    "simulate": "SIMULATE=1 vitest run test/simulate.test.ts --silent=false",
    "bars": "GENERATE_BARS=1 vitest run test/bars.test.ts -t 'generates the bars'"
  },
  "dependencies": {
    "kolmafia": "latest",
    "libram": "^0.11.35"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^25.3.0",
    "create-kolmafia-script": "latest",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.5.3",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
